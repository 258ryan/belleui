<?xml version="1.0" encoding="utf-8"?>
<!-- Belle notification plate: dark glossy panel, light top edge, thin dark line underneath (replaces the flat Android card) -->
<ripple android:color="#401080dd"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient android:startColor="#ff3a3a3a" android:centerColor="#ff262626" android:endColor="#ff1e1e1e" android:angle="270" android:type="linear" />
                </shape>
            </item>
            <item android:height="1.0dip" android:gravity="top">
                <shape android:shape="rectangle"><solid android:color="#33ffffff" /></shape>
            </item>
            <item android:height="1.0dip" android:gravity="bottom">
                <shape android:shape="rectangle"><solid android:color="#ff000000" /></shape>
            </item>
        </layer-list>
    </item>
</ripple>
