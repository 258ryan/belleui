<?xml version="1.0" encoding="utf-8"?>
<!-- Belle notification plate. The System UI casts the first layer to a GradientDrawable, so it must stay ripple > one shape. -->
<ripple android:color="#401080dd"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#ff343434" android:endColor="#ff1c1c1c" android:angle="270" android:type="linear" />
        </shape>
    </item>
</ripple>
