<resources>
    <!-- Wallpaper theme: the window is transparent and the system wallpaper shows through. -->
    <style name="Theme.Belle" parent="@android:style/Theme.Wallpaper.NoTitleBar.Fullscreen">
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>
