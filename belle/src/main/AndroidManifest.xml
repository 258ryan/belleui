<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- lets every Belle app read the theme colour and sound setting offered by Styles -->
    <queries>
        <provider android:authorities="com.belleui.styles.theme" />
        <!-- the apps tell the Belle status bar (System UI) what their screen is called; without this Android hides it from apps that are not privileged -->
        <package android:name="com.android.systemui" />
    </queries>
</manifest>
