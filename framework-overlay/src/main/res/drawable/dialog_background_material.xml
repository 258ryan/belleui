<?xml version="1.0" encoding="utf-8"?>
<!-- Belle dialog plate (qtg_fr_popup). The window background's padding is what the dialog's content is laid out in, so the larger bottom inset keeps the whole box
     (its buttons included) above the 27 px key-hint bar at the foot of the screen instead of under it. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="10dp" android:insetTop="10dp" android:insetRight="10dp" android:insetBottom="36dp"
    android:drawable="@drawable/belle_popup" />
