<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:state_checked="true"><layer-list><item android:width="28dp" android:height="28dp" android:gravity="center" android:drawable="@drawable/belle_radio_on_disabled" /></layer-list></item>
    <item android:state_enabled="false"><layer-list><item android:width="28dp" android:height="28dp" android:gravity="center" android:drawable="@drawable/belle_radio_off_disabled" /></layer-list></item>
    <item android:state_pressed="true"><layer-list><item android:width="28dp" android:height="28dp" android:gravity="center" android:drawable="@drawable/belle_radio_pressed" /></layer-list></item>
    <item android:state_checked="true"><layer-list><item android:width="28dp" android:height="28dp" android:gravity="center" android:drawable="@drawable/belle_radio_on" /></layer-list></item>
    <item><layer-list><item android:width="28dp" android:height="28dp" android:gravity="center" android:drawable="@drawable/belle_radio_off" /></layer-list></item>
</selector>
