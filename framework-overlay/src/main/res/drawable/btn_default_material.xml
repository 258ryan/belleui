<?xml version="1.0" encoding="utf-8"?>
<!-- Belle push button (qtg_fr_pushbutton_*): the frame stretches with 20 px corners -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:drawable="@drawable/belle_btn_disabled" />
    <item android:state_pressed="true" android:drawable="@drawable/belle_btn_pressed" />
    <item android:state_focused="true" android:drawable="@drawable/belle_btn_pressed" />
    <item android:drawable="@drawable/belle_btn_normal" />
</selector>
